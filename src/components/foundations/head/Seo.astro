---
import { AstroSeo } from "@astrolib/seo";

// Fallback metadata. Every indexable page should pass its own title AND
// description — duplicate descriptions across the site suppress rankings.
const defaultTitle = "Robot Barista Systems & Robotic Coffee Kiosks — Artidyn Robotics";
const defaultDescription = "Artidyn Robotics tests and deploys commercial robot baristas — robotic coffee kiosks and automated espresso bars for hotels, airports, offices, and vending operators.";
const defaultImage = "https://www.artidyn.ai/og-image.jpg"; // Absolute URL is safer for social sharing

// Allow individual pages to override these
const { 
  title = defaultTitle, 
  description = defaultDescription,
  image = defaultImage,
  ...props 
} = Astro.props;

// Construct the full canonical URL for the current page
// Ensure it ends with a slash if it's not the homepage and doesn't have an extension
let path = Astro.url.pathname;
if (path !== "/" && !path.endsWith("/") && !path.includes(".")) {
  path += "/";
}
const canonicalURL = new URL(path, "https://www.artidyn.ai/").toString();
---

<AstroSeo
  title={title}
  description={description}
  canonical={canonicalURL}
  openGraph={{
    url: canonicalURL,
    title: title,
    description: description,
    images: [
      {
        url: image,
        // Assuming your og-image.jpg is standard size, otherwise adjust
        width: 1200, 
        height: 630,
        alt: "Artidyn Robotics - Certified Beverage Automation",
        type: "image/jpeg",
      },
    ],
    site_name: "Artidyn Robotics",
    type: "website",
    locale: "en_US",
  }}
  twitter={{
    handle: "@artidynrobotics", 
    site: "@artidynrobotics",
    cardType: "summary_large_image",
  }}
  {...props}
/>

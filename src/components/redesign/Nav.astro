---
// Tech Clarity — sticky top navigation with one persistent CTA.
interface Props {
  active?: "robots" | "solutions" | "about";
}
const { active } = Astro.props;

const links = [
  { href: "/products/", label: "Robots", key: "robots" },
  { href: "/solutions/", label: "Solutions", key: "solutions" },
  { href: "/#process", label: "Process", key: "process" },
  { href: "/about/", label: "About", key: "about" },
];
const linkBase = "text-sm transition-colors";
---

<header
  class="sticky top-0 z-100 border-b border-line bg-white/94 backdrop-blur-md"
>
  <nav class="mx-auto flex h-[68px] max-w-[1240px] items-center gap-10 px-8">
    <a href="/" class="mr-auto flex items-center gap-2.5">
      <img src="/mark-green.svg" alt="" class="h-[66px] w-auto" />
      <span class="text-[25px] font-bold tracking-[0.02em] text-ink"
        >Artidyn<span class="text-brand"> Robotics</span></span
      >
    </a>

    <!-- Desktop links -->
    <div class="hidden items-center gap-10 md:flex">
      {
        links.map((l) => (
          <a
            href={l.href}
            class:list={[
              linkBase,
              active === l.key
                ? "text-brand font-semibold"
                : "text-body font-medium hover:text-brand",
            ]}
          >
            {l.label}
          </a>
        ))
      }
    </div>

    <a
      href="/contact/"
      class="rounded-lg bg-brand px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-brand-hover"
      >Get a recommendation</a
    >

    <!-- Mobile menu toggle -->
    <button
      id="nav-toggle"
      type="button"
      aria-label="Toggle navigation menu"
      aria-expanded="false"
      class="-mr-1 inline-flex size-9 items-center justify-center rounded-lg text-ink hover:bg-surface md:hidden"
    >
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
      </svg>
    </button>
  </nav>

  <!-- Mobile dropdown -->
  <div
    id="nav-menu"
    class="hidden border-t border-line bg-white md:hidden"
  >
    <div class="mx-auto flex max-w-[1240px] flex-col px-8 py-2">
      {
        links.map((l) => (
          <a
            href={l.href}
            class:list={[
              "border-b border-line-faint py-3 text-sm last:border-0",
              active === l.key ? "text-brand font-semibold" : "text-body font-medium",
            ]}
          >
            {l.label}
          </a>
        ))
      }
    </div>
  </div>
</header>

<script is:inline>
  (() => {
    const toggle = document.getElementById("nav-toggle");
    const menu = document.getElementById("nav-menu");
    if (!toggle || !menu) return;
    toggle.addEventListener("click", () => {
      const open = menu.classList.toggle("hidden") === false;
      toggle.setAttribute("aria-expanded", String(open));
    });
  })();
</script>

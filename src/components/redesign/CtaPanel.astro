---
// Tech Clarity — bordered CTA panel used at the foot of most pages.
interface Props {
  title: string;
  body: string;
  primaryLabel?: string;
  primaryHref?: string;
  showEmail?: boolean;
  class?: string;
}
const {
  title,
  body,
  primaryLabel = "Get a recommendation",
  primaryHref = "/contact/",
  showEmail = false,
  class: className = "",
} = Astro.props;
---

<section class={className}>
  <div class="mx-auto max-w-[1240px] px-8">
    <div
      class="flex flex-col items-start gap-8 rounded-2xl border border-line bg-surface p-10 md:flex-row md:items-center md:justify-between md:gap-12 md:p-14"
    >
      <div>
        <h2
          class="text-balance text-[clamp(24px,2.2vw,32px)] font-bold leading-tight tracking-[-0.025em] text-ink"
        >
          {title}
        </h2>
        <p class="mt-3 max-w-[520px] text-[15.5px] leading-relaxed text-body">
          {body}
        </p>
      </div>
      <div class="flex flex-col items-start gap-3.5">
        <a
          href={primaryHref}
          class="whitespace-nowrap rounded-lg bg-brand px-7 py-3.5 text-[15px] font-semibold text-white transition-colors hover:bg-brand-hover"
          >{primaryLabel}</a
        >
        {
          showEmail && (
            <a
              href="mailto:hi@artidyn.ai"
              class="text-sm font-medium text-brand hover:text-brand-hover"
            >
              hi@artidyn.ai
            </a>
          )
        }
      </div>
    </div>
  </div>
</section>

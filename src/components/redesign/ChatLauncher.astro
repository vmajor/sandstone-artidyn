---
// Click-to-load Crisp chat.
//
// Nothing is requested from client.crisp.chat until the visitor presses this
// button. That buys three things at once:
//   1. zero third-party JS on initial load, so Core Web Vitals stay clean
//   2. no chat cookies until the visitor has actively asked for chat, which
//      keeps us out of prior-consent territory without a banner
//   3. no "we're away" bubble implying a live queue we don't staff
//
// Progressive enhancement: with JS off (or if Crisp is blocked) this stays an
// ordinary link to the contact form.
//
// The website ID is public by design — it ships in Crisp's own client snippet.
const CRISP_WEBSITE_ID = "56e97042-b439-4215-805b-bab65c80167b";
---

<a
  id="chat-launcher"
  href="/contact/"
  data-crisp-id={CRISP_WEBSITE_ID}
  aria-label="Chat with us, or open the contact form"
  class="fixed bottom-5 right-5 z-50 inline-flex items-center gap-2.5 rounded-full bg-brand px-5 py-3.5 text-[14.5px] font-semibold text-white shadow-[0_8px_24px_-8px_rgba(23,32,29,0.45)] transition-colors hover:bg-brand-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand aria-busy:opacity-70 print:hidden"
>
  <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
    <path
      d="M17 12a2 2 0 0 1-2 2H7l-4 3V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v7Z"
      stroke="currentColor"
      stroke-width="1.7"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
  </svg>
  <span>Chat with us</span>
</a>

<script is:inline>
  (() => {
    const el = document.getElementById("chat-launcher");
    if (!el) return;
    let started = false;

    el.addEventListener("click", (ev) => {
      // Let modified clicks and non-primary buttons fall through to /contact/.
      if (ev.metaKey || ev.ctrlKey || ev.shiftKey || ev.altKey || ev.button !== 0) return;
      ev.preventDefault();
      if (started) return;
      started = true;
      el.setAttribute("aria-busy", "true");

      // Queue the open before the client loads; Crisp replays $crisp on boot.
      window.$crisp = [];
      window.CRISP_WEBSITE_ID = el.dataset.crispId;
      window.$crisp.push(["do", "chat:open"]);

      const s = document.createElement("script");
      s.src = "https://client.crisp.chat/l.js";
      s.async = true;
      // Once Crisp's own launcher is up, ours would be a duplicate.
      s.onload = () => el.remove();
      // Blocked by an extension or offline — fall back to the contact form.
      s.onerror = () => {
        window.location.href = "/contact/";
      };
      document.head.appendChild(s);
    });
  })();
</script>

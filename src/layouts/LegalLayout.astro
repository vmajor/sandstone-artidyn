---
import BaseLayout from "@/layouts/BaseLayout.astro";
const { frontmatter } = Astro.props;
// Legal pages otherwise inherit the sitewide fallback description, which put
// five identical descriptions in the index.
const description = `${frontmatter.page} for Artidyn Robotics LLC, Sheridan, Wyoming. Last updated ${new Date(frontmatter.pubDate).toLocaleDateString("en-US", { year: "numeric", month: "long" })}.`;
const container = "mx-auto max-w-[1240px] px-8";
const updated = new Date(frontmatter.pubDate).toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
});
---

<BaseLayout title={`${frontmatter.page} — Artidyn Robotics`} description={description} chat={false}>
  <section class="border-b border-line bg-surface">
    <div class={`${container} max-w-[820px] pb-14 pt-[72px]`}>
      <h1 class="text-[clamp(30px,2.8vw,44px)] font-bold tracking-[-0.03em] text-ink">
        {frontmatter.page}
      </h1>
      <p class="mt-3 text-[14.5px] text-muted">Last updated on <time>{updated}</time></p>
    </div>
  </section>
  <article class={`${container} max-w-[820px] py-12`}>
    <div class="prose prose-neutral max-w-none text-body prose-headings:tracking-tight prose-headings:text-ink prose-strong:text-ink prose-a:text-brand prose-a:no-underline hover:prose-a:text-brand-hover">
      <slot />
    </div>
  </article>
</BaseLayout>

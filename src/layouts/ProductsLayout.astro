---
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import CtaPanel from "@/components/redesign/CtaPanel.astro";
import ProductStructuredData from "@/components/foundations/head/ProductStructuredData.astro";
import BreadcrumbStructuredData from "@/components/foundations/head/BreadcrumbStructuredData.astro";
import {
  ROBOT_CONTENT,
  TAG_STYLES,
  fmtDimensions,
  fmtFootprint,
  fmtWeight,
  fmtPower,
  fmtCupCapacity,
  type RobotSlug,
} from "@/data/robots";

const { frontmatter, slug } = Astro.props;
const c = ROBOT_CONTENT[slug as RobotSlug];
const tag = TAG_STYLES[c.tag];
const fm = frontmatter;

const payments = fm.paymentSystems?.join(" · ");
const specsLeft = [
  { label: "Dimensions", value: fmtDimensions(fm.dimensions) },
  { label: "Footprint", value: fmtFootprint(fm.area) },
  { label: "Weight", value: fmtWeight(fm.weight) },
  { label: "Power", value: fmtPower(fm.power) },
  { label: "Kinematics", value: fm.kinematics },
  { label: "Espresso unit", value: fm.espressoUnit },
  { label: "Enclosure", value: fm.enclosureType },
  { label: "Mobility", value: fm.mobility },
].filter((s) => s.value && s.value !== "—");

const specsRight = [
  { label: "Throughput", value: fm.throughput },
  { label: "Production time", value: fm.productionTime },
  { label: "Recipes", value: fm.recipes },
  { label: "Syrups", value: fm.syrups },
  { label: "Cup capacity", value: fmtCupCapacity(fm.cupCapacity) },
  { label: "Ice capacity", value: fm.iceCapacity },
  { label: "Cleaning", value: fm.cleaningSystem },
  { label: "Display / payment", value: [fm.display, payments].filter(Boolean).join(" · ") },
].filter((s) => s.value && s.value !== "—");

const container = "mx-auto max-w-[1240px] px-8";

const crumbs = [
  { name: "Home", href: "/" },
  { name: "Robots", href: "/products/" },
  { name: fm.title, href: `/products/${slug}/` },
];

// The environment each machine is primarily sold into — used for further reading.
const ENVIRONMENT: Record<string, { href: string; label: string }> = {
  iris: { href: "/solutions/airports/", label: "Robot baristas for airports and transit" },
  "iris-pro": { href: "/solutions/offices/", label: "Robot baristas for corporate offices" },
  "iris-max": { href: "/solutions/vending-operators/", label: "Robotic coffee kiosks for operators" },
  "argus-axis": { href: "/solutions/hotels/", label: "Robot baristas for hotels and resorts" },
  "argus-art": { href: "/solutions/hotels/", label: "Robot baristas for hotels and resorts" },
};
const env = ENVIRONMENT[slug as string];
const specRow =
  "flex justify-between gap-6 border-b border-line-faint py-3.5 last:border-0";
---

<BaseLayout title={fm.title} description={fm.description} navActive="robots">
  <ProductStructuredData product={fm} slug={slug} />
  <BreadcrumbStructuredData items={crumbs} />

  <!-- ===== Product hero ===== -->
  <section class="border-b border-line bg-surface">
    <div class={`${container} pb-[72px] pt-12`}>
      <div class="flex items-center gap-2 text-[13px] text-faint">
        <a href="/products/" class="text-muted hover:text-brand">Robot catalog</a>
        <span>/</span>
        <span class="font-medium text-ink">{c.name}</span>
      </div>
      <div class="mt-10 grid items-center gap-16 lg:grid-cols-2">
        <div
          class="flex aspect-[4/3] items-center justify-center rounded-xl border border-line bg-white p-10"
        >
          <Image
            src={fm.cover.url}
            alt={fm.cover.alt}
            width={800}
            height={600}
            loading="eager"
            class="max-h-full w-auto max-w-[80%] object-contain"
          />
        </div>
        <div>
          <span
            class="inline-block rounded-[5px] px-2.5 py-1 text-[11px] font-semibold uppercase tracking-[0.06em]"
            style={`color:${tag.color};background:${tag.bg}`}>{c.tier}</span
          >
          {/* Subtitle sits inside the H1: same visual result, but the page's
              strongest heading carries the descriptive phrase, not just "Iris". */}
          <h1
            class="mt-4 text-[clamp(34px,3.2vw,48px)] font-bold leading-[1.05] tracking-[-0.03em] text-ink"
          >
            {c.name}
            <span
              class="mt-1.5 block text-base font-normal leading-snug tracking-normal text-muted"
              >{c.subtitle}</span
            >
          </h1>
          <p class="mt-5 max-w-[460px] text-[15.5px] leading-relaxed text-body">{c.heroPara}</p>
          <div class="mt-7 flex gap-7 border-t border-line pt-5.5">
            {
              c.heroStats.map((s) => (
                <div>
                  <p class="text-[20px] font-bold tabular-nums text-ink">{s.value}</p>
                  <p class="mt-0.5 text-[12.5px] text-muted">{s.label}</p>
                </div>
              ))
            }
          </div>
          <div class="mt-8 flex flex-wrap gap-3.5">
            <a
              href="/contact/"
              class="rounded-lg bg-brand px-6 py-3 text-[15px] font-semibold text-white transition-colors hover:bg-brand-hover"
              >Ask about {c.name}</a
            >
            <a
              href="/products/"
              class="rounded-lg border border-input px-6 py-3 text-[15px] font-semibold text-ink transition-colors hover:border-ink"
              >Compare models</a
            >
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Built for ===== -->
  <section>
    <div class={`${container} py-20`}>
      <h2 class="text-[clamp(24px,2.2vw,32px)] font-bold tracking-[-0.02em] text-ink">
        {c.builtForTitle}
      </h2>
      <div class="mt-10 grid gap-5 md:grid-cols-3">
        {
          c.highlights.map((h) => (
            <div class="rounded-xl border border-line p-6.5">
              <h3 class="text-[16.5px] font-bold text-ink">{h.title}</h3>
              <p class="mt-2.5 text-[14.5px] leading-relaxed text-body">{h.body}</p>
            </div>
          ))
        }
      </div>

      <!-- Overview prose (SEO copy from the product's markdown body) -->
      <div class="prose-overview mt-14 max-w-[720px] text-[15.5px] leading-relaxed text-body">
        <slot />
      </div>
    </div>
  </section>

  <!-- ===== Full specifications ===== -->
  <section class="border-t border-line bg-surface">
    <div class={`${container} pb-24 pt-20`}>
      <h2 class="text-[clamp(24px,2.2vw,32px)] font-bold tracking-[-0.02em] text-ink">
        Full specifications
      </h2>
      <div class="mt-10 grid gap-5 md:grid-cols-2">
        {
          [specsLeft, specsRight].map((col) => (
            <div class="rounded-xl border border-line bg-white px-6 py-2">
              {col.map((s) => (
                <div class={specRow}>
                  <span class="text-[13.5px] text-muted">{s.label}</span>
                  <span class="text-right font-mono text-[13px] text-ink">{s.value}</span>
                </div>
              ))}
            </div>
          ))
        }
      </div>
      <p class="mt-5 text-[13px] text-faint">{c.specFootnote}</p>
    </div>
  </section>

  <!-- ===== Fit guidance ===== -->
  <section>
    <div class={`${container} py-20`}>
      <div class="grid gap-5 md:grid-cols-2">
        <div class="rounded-xl border border-fit-border bg-fit-bg p-7">
          <h3 class="text-base font-bold text-brand">{c.chooseTitle}</h3>
          <div class="mt-4 flex flex-col gap-2.5">
            {
              c.choosePoints.map((pt) => (
                <div class="flex items-baseline gap-2.5">
                  <span class="font-bold text-brand">→</span>
                  <span class="text-[14.5px] leading-snug text-body">{pt}</span>
                </div>
              ))
            }
          </div>
        </div>
        <div class="rounded-xl border border-line p-7">
          <h3 class="text-base font-bold text-ink">Consider another model if</h3>
          <div class="mt-4 flex flex-col gap-2.5">
            {
              c.considerPoints.map((pt) => (
                <div class="flex items-baseline gap-2.5">
                  <span class="font-bold text-faint">→</span>
                  <span class="text-[14.5px] leading-snug text-body" set:html={pt} />
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Further reading ===== -->
  <section class="border-t border-line bg-surface">
    <div class={`${container} py-12`}>
      <p class="text-xs font-semibold uppercase tracking-[0.1em] text-faint">
        Further reading
      </p>
      <div class="mt-4 flex flex-wrap gap-x-8 gap-y-3">
        <a href="/robot-barista/" class="text-[14.5px] font-semibold text-brand hover:text-brand-hover"
          >Robot barista buyer's guide &rarr;</a
        >
        <a href="/robot-barista/cost/" class="text-[14.5px] font-semibold text-brand hover:text-brand-hover"
          >What a robot barista costs &rarr;</a
        >
        {
          env && (
            <a href={env.href} class="text-[14.5px] font-semibold text-brand hover:text-brand-hover">
              {env.label} &rarr;
            </a>
          )
        }
      </div>
    </div>
  </section>

  <!-- ===== CTA ===== -->
  <CtaPanel
    class="pb-20 pt-4"
    title={`See if ${c.name} pays for itself at your site.`}
    body="We'll model your traffic against verified throughput and give you a break-even estimate before you commit."
  />
</BaseLayout>

<style>
  /* Calm prose for the product overview markdown body */
  .prose-overview :global(p) {
    margin: 0 0 1rem;
  }
  .prose-overview :global(p:last-child) {
    margin-bottom: 0;
  }
  .prose-overview :global(strong) {
    color: var(--color-ink);
    font-weight: 600;
  }
  .prose-overview :global(a) {
    color: var(--color-brand);
    text-decoration: none;
  }
  .prose-overview :global(a:hover) {
    color: var(--color-brand-hover);
  }
</style>

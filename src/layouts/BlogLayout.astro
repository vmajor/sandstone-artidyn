---
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import CtaPanel from "@/components/redesign/CtaPanel.astro";
import { getCollection, getEntry } from "astro:content";
const { frontmatter } = Astro.props;

let teamEntry;
if (frontmatter.team) {
  try {
    teamEntry = await getEntry("team", frontmatter.team);
  } catch {
    teamEntry = undefined;
  }
  if (!teamEntry) {
    const teamCollection = await getCollection("team");
    const normalizedTeam = frontmatter.team.toLowerCase().replace(/\s+/g, "-");
    teamEntry = teamCollection.find(
      (member) =>
        member.slug === normalizedTeam ||
        member.slug === frontmatter.team ||
        member.data.name?.toLowerCase() === frontmatter.team.toLowerCase()
    );
  }
}

const authorName = teamEntry?.data.name ?? frontmatter.team ?? "Artidyn Editorial Team";
const authorHref = teamEntry ? `/team/${teamEntry.slug}/` : undefined;
const fmtDate = (d: Date) =>
  new Date(d).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "2-digit" });
const container = "mx-auto max-w-[1240px] px-8";
---

<BaseLayout title={frontmatter.title} description={frontmatter.description} chat={false}>
  <!-- Header -->
  <section class="border-b border-line bg-surface">
    <div class={`${container} max-w-[820px] pb-14 pt-[72px]`}>
      <div class="flex items-center gap-2 text-[13px] text-faint">
        <a href="/blog/" class="text-muted hover:text-brand">Insights</a>
        <span>/</span>
        <span class="font-mono">{fmtDate(frontmatter.pubDate)}</span>
      </div>
      <h1 class="mt-5 text-[clamp(30px,2.8vw,44px)] font-bold leading-[1.12] tracking-[-0.03em] text-ink">
        {frontmatter.title}
      </h1>
      <p class="mt-4 text-[17px] leading-relaxed text-body">{frontmatter.description}</p>
      <p class="mt-5 text-[13.5px] text-muted">
        By {
          authorHref ? (
            <a href={authorHref} class="font-medium text-brand hover:text-brand-hover">{authorName}</a>
          ) : (
            <span class="font-medium text-ink">{authorName}</span>
          )
        }
      </p>
    </div>
  </section>

  <!-- Cover -->
  {
    frontmatter.image && (
      <div class={`${container} max-w-[820px] pt-10`}>
        <div class="aspect-video overflow-hidden rounded-xl border border-line">
          <Image
            width={1280}
            height={720}
            loading="eager"
            alt={frontmatter.image.alt}
            src={frontmatter.image.url}
            class="size-full object-cover"
          />
        </div>
      </div>
    )
  }

  <!-- Article body -->
  <article class={`${container} max-w-[820px] py-12`}>
    <div class="prose prose-neutral max-w-none text-body prose-headings:tracking-tight prose-headings:text-ink prose-strong:text-ink prose-a:text-brand prose-a:no-underline hover:prose-a:text-brand-hover">
      <slot />
    </div>
  </article>

  <CtaPanel
    class="pb-20 pt-4"
    title="Thinking about automating your beverage service?"
    body="Tell us about your site and we'll recommend one machine, with the reasoning — even if the answer is to wait."
  />
</BaseLayout>

---
import BaseLayout from "@/layouts/BaseLayout.astro";

const expectations = [
  { n: "01", t: "We reply within one business day." },
  { n: "02", t: "Your call is with a founder, not a sales team." },
  { n: "03", t: "The recommendation is free, whether or not you buy." },
];
const container = "mx-auto max-w-[1240px] px-8";
const inputCls =
  "w-full rounded-lg border border-input bg-white px-3.5 py-2.5 text-[14.5px] text-ink focus:border-brand focus:outline-none";
const labelCls = "mb-1.5 block text-[13px] font-semibold text-body";
---

<BaseLayout title="Contact — Artidyn Robotics" description="Tell us about your site and we'll recommend one machine, with the reasoning. Reply within one business day, straight from a founder.">
  <section class="border-b border-line bg-surface">
    <div class={`${container} grid items-start gap-16 pb-24 pt-[72px] lg:grid-cols-[1fr_1.2fr] lg:gap-20`}>
      <!-- Left: pitch -->
      <div>
        <p class="text-[13px] font-semibold uppercase tracking-[0.1em] text-brand">Get a recommendation</p>
        <h1 class="mt-3.5 text-[clamp(32px,3vw,44px)] font-bold leading-[1.12] tracking-[-0.03em] text-ink">
          Tell us about your site.
        </h1>
        <p class="mt-4.5 text-base leading-relaxed text-body">
          One 30-minute call: your space, power, and traffic in — a specific
          machine, price, and ROI projection out. If a robot doesn't make sense
          for your site, we'll say so.
        </p>
        <div class="mt-10 flex flex-col gap-6">
          {
            expectations.map((e) => (
              <div class="flex items-baseline gap-3.5">
                <span class="font-mono text-[13px] text-brand">{e.n}</span>
                <p class="text-[14.5px] leading-relaxed text-body">{e.t}</p>
              </div>
            ))
          }
        </div>
        <div class="mt-12 border-t border-line pt-7">
          <p class="text-xs font-semibold uppercase tracking-[0.1em] text-faint">Or write directly</p>
          <a href="mailto:hi@artidyn.ai" class="mt-2 inline-block text-base font-semibold text-brand hover:text-brand-hover">
            hi@artidyn.ai
          </a>
          <p class="mt-4 text-[13.5px] text-faint">Artidyn Robotics LLC · Sheridan, WY · Taipei, Taiwan</p>
        </div>
      </div>

      <!-- Right: form card -->
      <div class="rounded-2xl border border-line bg-white p-8 sm:p-10">
        <!-- Success state -->
        <div id="contact-success" class="hidden py-12 text-center">
          <p class="text-4xl text-brand">✓</p>
          <h2 class="mt-4 text-[22px] font-bold text-ink">Thanks — we've got it.</h2>
          <p class="mt-2.5 text-[15px] leading-relaxed text-body">
            We'll reply within one business day to set up the call.
          </p>
        </div>

        <!-- Form -->
        <form
          id="contact-form"
          name="contact"
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
          class="flex flex-col gap-5"
        >
          <input type="hidden" name="form-name" value="contact" />
          <p class="hidden">
            <label>Don't fill this out: <input name="bot-field" /></label>
          </p>

          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label for="c-name" class={labelCls}>Name</label>
              <input id="c-name" name="name" type="text" required placeholder="Your name" class={inputCls} />
            </div>
            <div>
              <label for="c-email" class={labelCls}>Work email</label>
              <input id="c-email" name="email" type="email" required placeholder="you@company.com" class={inputCls} />
            </div>
          </div>

          <div>
            <label for="c-env" class={labelCls}>Where would the machine live?</label>
            <select id="c-env" name="environment" class={inputCls}>
              <option>Vending / kiosk location</option>
              <option>Hotel or resort</option>
              <option>Airport or transit hub</option>
              <option>Corporate office</option>
              <option>Somewhere else</option>
            </select>
          </div>

          <div>
            <label for="c-msg" class={labelCls}>About the site</label>
            <textarea
              id="c-msg"
              name="message"
              rows="4"
              placeholder="Location, expected traffic, space available, timeline…"
              class={`${inputCls} resize-y`}></textarea>
          </div>

          <p id="contact-error" class="hidden text-[13px] text-red-600">
            Something went wrong. Please try again or email hi@artidyn.ai.
          </p>

          <button
            type="submit"
            id="contact-submit"
            class="rounded-lg bg-brand px-7 py-3.5 text-[15px] font-semibold text-white transition-colors hover:bg-brand-hover disabled:opacity-60"
          >
            Request the call
          </button>
          <p class="text-[12.5px] text-faint">
            No newsletter, no drip campaign — just a reply about your site.
          </p>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  const form = document.getElementById("contact-form");
  const success = document.getElementById("contact-success");
  const errorEl = document.getElementById("contact-error");
  const submit = document.getElementById("contact-submit");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    errorEl?.classList.add("hidden");
    if (submit) {
      submit.disabled = true;
      submit.textContent = "Sending…";
    }
    try {
      const res = await fetch("/contact/", {
        method: "POST",
        headers: { "Content-Type": "application/x-www-form-urlencoded" },
        body: new URLSearchParams(new FormData(form)).toString(),
      });
      if (!res.ok) throw new Error("Bad response");
      form.classList.add("hidden");
      success?.classList.remove("hidden");
    } catch (err) {
      errorEl?.classList.remove("hidden");
      if (submit) {
        submit.disabled = false;
        submit.textContent = "Request the call";
      }
    }
  });
</script>

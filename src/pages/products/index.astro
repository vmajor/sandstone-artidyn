---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import RobotCard from "@/components/redesign/RobotCard.astro";
import CtaPanel from "@/components/redesign/CtaPanel.astro";
import {
  ROBOT_ORDER,
  ROBOT_CONTENT,
  fmtPrice,
  fmtServeTime,
  fmtFootprint,
  fmtDimensions,
  fmtPower,
  fmtWeight,
  fmtCupCapacity,
  type RobotSlug,
} from "@/data/robots";

const products = await getCollection("products");
const ordered = ROBOT_ORDER.map((slug) => products.find((p) => p.slug === slug)).filter(
  (p): p is (typeof products)[number] => Boolean(p)
);

const filters = [
  { key: "all", label: "All machines" },
  { key: "high-volume", label: "High volume" },
  { key: "compact", label: "Compact" },
  { key: "craft", label: "Craft" },
];

// Comparison table — values in catalog order, mono.
const specRows: { label: string; values: string[] }[] = [
  { label: "Price", values: ordered.map((p) => fmtPrice(p.data.price)) },
  { label: "Throughput", values: ordered.map((p) => p.data.throughput ?? "—") },
  { label: "Serve time", values: ordered.map((p) => fmtServeTime(p.data.productionTime)) },
  { label: "Recipes", values: ordered.map((p) => ROBOT_CONTENT[p.slug as RobotSlug].tableRecipes) },
  { label: "Latte art", values: ordered.map((p) => ROBOT_CONTENT[p.slug as RobotSlug].tableLatteArt) },
  { label: "Enclosure", values: ordered.map((p) => ROBOT_CONTENT[p.slug as RobotSlug].tableEnclosure) },
  { label: "Espresso unit", values: ordered.map((p) => ROBOT_CONTENT[p.slug as RobotSlug].tableEspresso) },
  { label: "Footprint", values: ordered.map((p) => fmtFootprint(p.data.area)) },
  { label: "Dimensions", values: ordered.map((p) => fmtDimensions(p.data.dimensions)) },
  { label: "Weight", values: ordered.map((p) => fmtWeight(p.data.weight)) },
  { label: "Power", values: ordered.map((p) => fmtPower(p.data.power)) },
  { label: "Cup capacity", values: ordered.map((p) => fmtCupCapacity(p.data.cupCapacity)) },
  { label: "Payments", values: ordered.map((p) => ROBOT_CONTENT[p.slug as RobotSlug].tablePayments) },
];

const container = "mx-auto max-w-[1240px] px-8";
---

<BaseLayout
  title="Robot Barista Catalog — 5 Machines Compared, Specs & Prices"
  description="Compare five commercial robot baristas side by side: throughput, serve time, footprint, power, latte art, and price from $27,000 to $42,000. Figures from our own testing."
  navActive="robots"
>
  <!-- ===== Header ===== -->
  <section class="border-b border-line bg-surface">
    <div class={`${container} pb-14 pt-[72px]`}>
      <p class="text-[13px] font-semibold uppercase tracking-[0.1em] text-brand">The certified range</p>
      <h1 class="mt-3.5 text-[clamp(34px,3.2vw,48px)] font-bold leading-[1.1] tracking-[-0.03em] text-ink">
        Five machines, tested by us.
      </h1>
      <p class="mt-4.5 max-w-[600px] text-[16.5px] leading-relaxed text-body">
        Every robot in this catalog has been vetted and certified by our
        engineering team. The numbers below come from our own testing, not the
        manufacturer's brochure.
      </p>
      <p class="mt-4 max-w-[600px] text-[16.5px] leading-relaxed text-body">
        New to the category? The <a
          href="/robot-barista/"
          class="font-semibold text-brand hover:text-brand-hover">robot barista buyer's guide</a
        > covers how these machines work, what rated throughput really means, and
        <a href="/robot-barista/cost/" class="font-semibold text-brand hover:text-brand-hover"
          >what they cost to run</a
        >.
      </p>
      <div class="mt-9 flex flex-wrap gap-2">
        {
          filters.map((f, i) => (
            <button
              type="button"
              data-filter={f.key}
              class:list={[
                "rounded-lg border px-4 py-2.5 text-sm font-semibold transition-colors",
                i === 0 ? "border-ink bg-ink text-white" : "border-input bg-white text-body",
              ]}
            >
              {f.label}
            </button>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===== Catalog grid ===== -->
  <section>
    <div class={`${container} pb-20 pt-14`}>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          ordered.map((product) => (
            <div data-card data-category={product.data.category}>
              <RobotCard product={product} variant="catalog" />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===== Comparison table ===== -->
  <section class="border-t border-line bg-surface">
    <div class={`${container} pb-24 pt-20`}>
      <h2 class="text-[clamp(24px,2.2vw,32px)] font-bold tracking-[-0.02em] text-ink">Side by side</h2>
      <p class="mt-3 text-[15px] text-muted">All figures verified in Artidyn certification testing.</p>
      <div class="mt-9 overflow-x-auto rounded-xl border border-line bg-white">
        <table class="w-full min-w-[900px] border-collapse">
          <thead>
            <tr>
              <th class="border-b border-line bg-surface px-5 py-4 text-left"></th>
              {
                ordered.map((p) => {
                  const c = ROBOT_CONTENT[p.slug as RobotSlug];
                  return (
                    <th class="border-b border-line bg-surface px-5 py-4 text-left">
                      <span class="block text-[15px] font-bold text-ink">{c.name}</span>
                      <span class="mt-0.5 block text-[11.5px] font-semibold uppercase tracking-[0.05em] text-brand">
                        {c.tier}
                      </span>
                    </th>
                  );
                })
              }
            </tr>
          </thead>
          <tbody>
            {
              specRows.map((row) => (
                <tr>
                  <td class="whitespace-nowrap border-b border-line-faint px-5 py-3 text-[13.5px] font-semibold text-body">
                    {row.label}
                  </td>
                  {row.values.map((v) => (
                    <td class="border-b border-line-faint px-5 py-3 font-mono text-[13px] text-ink">{v}</td>
                  ))}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ===== CTA ===== -->
  <CtaPanel
    class="py-20"
    title="Not sure which one fits your site?"
    body="Tell us about your space, power, and traffic — we'll recommend one machine, with the reasoning."
  />
</BaseLayout>

<script is:inline>
  (() => {
    const buttons = Array.from(document.querySelectorAll("[data-filter]"));
    const cards = Array.from(document.querySelectorAll("[data-card]"));
    function apply(key) {
      buttons.forEach((b) => {
        const active = b.dataset.filter === key;
        b.classList.toggle("border-ink", active);
        b.classList.toggle("bg-ink", active);
        b.classList.toggle("text-white", active);
        b.classList.toggle("border-input", !active);
        b.classList.toggle("bg-white", !active);
        b.classList.toggle("text-body", !active);
      });
      cards.forEach((c) => {
        c.classList.toggle("hidden", key !== "all" && c.dataset.category !== key);
      });
    }
    buttons.forEach((b) => b.addEventListener("click", () => apply(b.dataset.filter)));
  })();
</script>

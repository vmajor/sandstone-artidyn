---
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import CtaPanel from "@/components/redesign/CtaPanel.astro";
import { SOLUTIONS } from "@/data/environments";
import sol1 from "@/assets/images/solutions/1.png";
import sol2 from "@/assets/images/solutions/2.png";
import sol3 from "@/assets/images/solutions/3.png";

const solImg = { 1: sol1, 2: sol2, 3: sol3 } as const;
const container = "mx-auto max-w-[1240px] px-8";
---

<BaseLayout
  title="Robot Barista Solutions by Environment — Artidyn Robotics"
  description="Which robot barista suits a hotel lobby, an airport concourse, an office pantry, or a vending route — and why. Machine recommendations matched to each environment."
  navActive="solutions"
>
  <!-- ===== Header ===== -->
  <section class="border-b border-line bg-surface">
    <div class={`${container} pb-16 pt-[72px]`}>
      <p class="text-[13px] font-semibold uppercase tracking-[0.1em] text-brand">Solutions by environment</p>
      <h1 class="mt-3.5 max-w-[720px] text-[clamp(34px,3.2vw,48px)] font-bold leading-[1.1] tracking-[-0.03em] text-ink">
        The right machine depends on where it lives.
      </h1>
      <p class="mt-4.5 max-w-[620px] text-[16.5px] leading-relaxed text-body">
        Throughput, footprint, and theater trade off against each other. We
        match machines to environments — these are the four we know best.
      </p>
    </div>
  </section>

  <!-- ===== Solution rows ===== -->
  <section>
    <div class={`${container} pb-20 pt-8`}>
      {
        SOLUTIONS.map((s, i) => {
          const imageLeft = i % 2 === 0;
          return (
            <div class="grid items-center gap-14 border-b border-line py-14 lg:grid-cols-2">
              <div class:list={[!imageLeft && "lg:order-2"]}>
                <div class="aspect-[4/3] overflow-hidden rounded-xl border border-line">
                  <Image
                    src={solImg[s.imgKey]}
                    alt={s.title}
                    width={720}
                    height={540}
                    loading={i === 0 ? "eager" : "lazy"}
                    class="size-full object-cover"
                  />
                </div>
              </div>
              <div class:list={[!imageLeft && "lg:order-1"]}>
                <p class="font-mono text-[13px] text-brand">{s.num}</p>
                <h2 class="mt-3 text-[clamp(24px,2.2vw,32px)] font-bold tracking-[-0.02em] text-ink">
                  <a href={s.href} class="hover:text-brand">{s.title}</a>
                </h2>
                <p class="mt-3.5 text-[15.5px] leading-relaxed text-body">{s.desc}</p>
                <div class="mt-5.5 flex flex-col gap-2.5">
                  {s.points.map((pt) => (
                    <div class="flex items-baseline gap-2.5">
                      <span class="text-sm font-bold text-brand">→</span>
                      <span class="text-[14.5px] leading-snug text-body">{pt}</span>
                    </div>
                  ))}
                </div>
                <a
                  href={s.href}
                  class="mt-6 inline-block text-[14.5px] font-semibold text-brand hover:text-brand-hover"
                >
                  {s.title} in depth &rarr;
                </a>
                <div class="mt-5 flex w-fit items-center gap-2.5 rounded-[10px] border border-line bg-surface px-4.5 py-3.5">
                  <span class="text-[13px] text-muted">Recommended:</span>
                  <a href={s.robotHref} class="text-sm font-bold text-brand hover:text-brand-hover">
                    {s.robot}
                  </a>
                  <span class="font-mono text-[12.5px] text-muted">{s.robotSpec}</span>
                </div>
              </div>
            </div>
          );
        })
      }
    </div>
  </section>

  <!-- ===== CTA ===== -->
  <CtaPanel
    class="pb-20 pt-4"
    title="Your environment isn't on this list?"
    body="We've deployed into malls, hospitals, universities, and events. Describe your site and we'll tell you what works — and what doesn't."
  />
</BaseLayout>
